# ─── District identity ──────────────────────────────────────────
# Copy this file to .env and fill in your values. Everything else
# (branding, OU maps, HR codes, buildings) is edited in the web UI
# under /settings after first boot.

# Your primary web domain. Used in generated URLs (onboarding
# links, password-reset emails, etc.).
DOMAIN=nexus.yourdistrict.org

# Your Google Workspace primary domain.
GOOGLE_DOMAIN=yourdistrict.org

# The admin mailbox Nexus impersonates for Directory + Gmail API
# calls. Must have the custom-role privileges described in
# docs/DISTRICT_SETUP.md (or be a super-admin, but that's overkill).
GOOGLE_ADMIN_EMAIL=nexus.svc@yourdistrict.org

# IANA time zone used for scheduled jobs (attendance-report send
# window, "today" boundaries, etc.).
TIMEZONE=America/New_York

# ─── Boot behavior ──────────────────────────────────────────────

# Set to "development" during first-boot to skip HTTPS-only cookies
# so you can log in over http://<vm-ip>:8080 before your TLS cert
# is in place. Flip to "production" after TLS is working.
APP_ENV=production

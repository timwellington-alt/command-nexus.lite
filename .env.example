# ─── District identity ──────────────────────────────────────────
# Copy this file to .env and fill in your values. Everything else
# (branding, OU maps, HR codes, buildings) is edited in the web UI
# under /settings after first boot.

# Your primary web domain. Used in generated URLs (onboarding
# links, password-reset emails, etc.).
DOMAIN=nexus.yourdistrict.org

# Your Google Workspace primary domain.
GOOGLE_DOMAIN=yourdistrict.org

# The admin mailbox Nexus impersonates for Directory + Gmail API
# calls. Must have the custom-role privileges described in
# docs/DISTRICT_SETUP.md (or be a super-admin, but that's overkill).
GOOGLE_ADMIN_EMAIL=nexus.svc@yourdistrict.org

# IANA time zone used for scheduled jobs (attendance-report send
# window, "today" boundaries, etc.).
TIMEZONE=America/New_York

# ─── Boot behavior ──────────────────────────────────────────────

# Set to "development" during first-boot to skip HTTPS-only cookies
# so you can log in over http://<vm-ip>:8080 before your TLS cert
# is in place. Flip to "production" after TLS is working.
APP_ENV=production

# ─── Auth paths (at least one must be enabled) ──────────────────
# Local-auth is the default. Admins created via the Settings UI (or
# via first_run.sh / the default admin@local bootstrap). argon2id
# hashed passwords, per-email lockout, forced-change on reset.
LOCAL_AUTH_ENABLED=true

# Google SSO is OPTIONAL. Flip this on if your district uses Google
# Workspace and you want staff to sign in with their district Google
# accounts. Requires a Google OAuth 2.0 Client ID + secret in
# secrets/ — see docs/DISTRICT_SETUP.pdf for the setup walkthrough.
# NOTE: this is separate from the Google service account that handles
# backend Directory / Gmail / Sheets API calls — that dependency is
# unrelated to this flag.
GOOGLE_AUTH_ENABLED=false

# ─── Caddy auto-TLS (optional) ──────────────────────────────────
# Only used if you deploy via docker-compose.caddy.yml. Let's Encrypt
# sends expiry notifications here if a renewal fails.
CADDY_ACME_EMAIL=admin@yourdistrict.org

# ─── DNS-01 ACME (optional, only for docker-compose.dns01.yml) ──
# API token for your DNS provider. Default plugin is Cloudflare; see
# docker/caddy-dns01/Dockerfile to swap providers.
CLOUDFLARE_API_TOKEN=
